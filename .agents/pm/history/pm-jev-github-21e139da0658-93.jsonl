{"hash_algorithm":"sha256","ts":"2026-11-06T04:42:48.455Z","author":"codex-sol","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"65e91a28c90311f3acf2869b","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/2","value":{"created_at":"2026-11-06T04:42:48.449Z","author":"codex-sol","text":"Packed live acceptance completed against 53 verified public tracker items, selecting the public Unicode defect item for one Noul question with two options. All five spellings returned P(defect)=0.7970235132224727, with 1182 admitted/native input tokens, one scoring token and num_ctx 8192. CLI decision latencies were 23174/25906/21684/19171/25853 ms in reference order; separate preflight timings and the artifact digest are in docs/decision-admission-reference-evidence.json. The temporary alias was copied from the installed model and removed after digest verification; no model pull. Decisions changed no tracker bytes."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-06T04:42:48.455Z"}],"before_hash":"80f502be122738d64e8536e08c5d4a8748bb880d7677059cea7799694f693968","after_hash":"779cd2d3117da3ba5be3c7e0c13787e1c73d3a48a9e9070a2471594e7cd7ae7f","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"6f8c33a4d37ecd6be2980facaa3bdc53b99f5094716ec1d5ddc86777044e17ff"}
