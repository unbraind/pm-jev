{"hash_algorithm":"sha256","ts":"2026-11-03T09:59:09.226Z","author":"pi-toolchain-glm-1103","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"9e1c18dd119f0404d66458ad","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-jev-6fs0"},{"op":"add","path":"/metadata/title","value":"Update triage and link backlog tests for typed host lookup refusals on the pinned toolchain"},{"op":"add","path":"/metadata/description","value":"The pm-toolchain Dependabot bump pins @unbrained/pm-cli 2026.10.28, whose GH-1613 change preserves typed PmClient lookup refusals: reading or mutating an item whose document is missing from disk now fails with the host code item_not_found instead of an unclassified error. The batch triage and link backlog tests asserted the old generic fallback reasons (jev_triage_failure, jev_link_failure); the host-error retention they guard (outcome failed, exit code 1, no receipts applied) is unchanged, and the rows now carry the more precise host code."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["dependencies","gh:unbraind/pm-jev#75","migration","sdk"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-03T09:59:09.226Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-03T09:59:09.226Z"},{"op":"add","path":"/metadata/author","value":"pi-toolchain-glm-1103"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"3997ead80d045cc98f3adff8f6bb1576d978726e9c38f6e1387d1a8f1cb4cac9","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"1da1663dc3bce1924ecefb485