{"hash_algorithm":"sha256","ts":"2026-10-21T21:24:47.193Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"4d1f11d43e9b72e57759789e","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/2","value":{"created_at":"2026-10-21T21:24:47.193Z","author":"codex-agent","text":"Public replay passed: verified three public commit archives and 381 items in read-only non-git copies; restored two historical duplicate records and reconciled seven sampled pair labels/retrieval flags, with authoritative tracker hashes unchanged and no git on the SDK/CLI path. Replayed all 156 frozen PR #37 scores (150 selection, 6 held-out), zero model calls. Costs 1/10/1 select 0.70: selection cost 45, coverage 7/150; held-out cost 0, coverage 2/6. Costs 20/10/1 and 100/10/1 select 0.80: selection cost 46, coverage 4/150; held-out cost 1, coverage 1/6. Small correlated holdout, two positives, and unadjudicated negative controls limit conclusions; wrong-type costs have synthetic evidence only. Receipt: calibration/cost-policy-report-v1.json."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-10-21T21:24:47.193Z"}],"before_hash":"63ee4a3056833537c48f96af6ef1b1a79a847f740ff3b5d4d0bd1b15bafafc4e","after_hash":"13e33e95b23f51919f59f938e82d2b6e8c36dfffe03d9e59e828cc27da9c5f94","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"a54f3d78b6097b202f1ed005fd48f40b62b55efe247a15af206d9fa51c4ac195"