{"hash_algorithm":"sha256","ts":"2026-10-28T15:20:42.674Z","author":"claude-hub","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"b72b4ad539c4794f7abb86ea","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.312","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-28T15:20:42.674Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-28T15:20:42.674Z","author":"claude-hub","text":"Evidence: the failed release job log shows 'npm error command git --no-replace-objects ls-remote ssh://git@github.com/release-artifact/package.tgz.git' and 'git@github.com: Permission denied (publickey)' on each of the 3 attempts (same failure in pm-evidence, pm-hypothesis, pm-jev, pm-lint, pm-memory, pm-review, pm-rlm and pm-swarm, which all carry the scaffold line). The other uses of release-artifact/package.tgz in release.yml are shell arguments (mv, sha256sum, openssl), not npm package specs. Fleet tracking: unbraind/pm-cli-companion item pm-cli-website-l9y4."}]}],"before_hash":"e67211457642163d4a803b09b0b3ef634484551f9ddecf9a2331e0c97d95469c","after_hash":"1c9c07debc32571aa7ae791bf86b4d51a4234122d066826c8d7e95e97abb7cdc","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"2f35700c0c8d050147f2997ecd81eae2a6786396f1d9a07b81190a8f5e7b7537"}
