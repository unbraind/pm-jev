{"hash_algorithm":"sha256","ts":"2026-10-28T15:20:41.183Z","author":"claude-hub","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"b72b4ad539c4794f7abb86ea","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.312","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-jev-tl8w"},{"op":"add","path":"/metadata/title","value":"Daily release never publishes: npm reads release-artifact/package.tgz as a GitHub repository"},{"op":"add","path":"/metadata/description","value":"The release job runs npm publish release-artifact/package.tgz. npm parses a bare dir/file.tgz spec as the GitHub shorthand owner/repo and runs git ls-remote ssh://git@github.com/release-artifact/package.tgz.git, which fails with Permission denied (publickey); after 3 attempts the job reports that nothing was published. Latest release run: https://github.com/unbraind/pm-jev/actions/runs/40672657971 (failure). Fix: publish ./release-artifact/package.tgz so npm reads the verified local archive."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":0},{"op":"add","path":"/metadata/tags","value":["ci","npm","release"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-28T15:20:41.183Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-28T15:20:41.183Z"},{"op":"add","path":"/metadata/author","value":"claude-hub"},{"op":"add","path":"/metadata/acceptance_criteria","value":"release.yml publishes ./release-artifact/package.tgz; no other npm or bun command passes a bare relative tarball path; the next daily release publishes to npm with provenance"},{"op":"add","path":"/metadata/severity","value":"high"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"391e7386e3c800a6290225f564ceda01999f073d8fe90cb78e75eef754a467e0","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"80bd1eb242c71e2dbcbf0d84086ffd800871c3bdf849e214b3b5ecad4f0e6ad2"}
