  "env HOME=$(mktemp -d) GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 nice -n 15 bun run release:check",project,codex-agent,"2026-10-19T15:34:43.957Z",local_mutation,feat/jev-dedupe
