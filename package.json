{
  "name": "pm-jev",
  "version": "2026.10.30",
  "description": "Typed, local-first System One decisions for pm-cli items (Jev-style models via @typesafe-ai/sdk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbraind/pm-jev.git"
  },
  "bugs": {
    "url": "https://github.com/unbraind/pm-jev/issues"
  },
  "homepage": "https://pm-cli.unbrained.dev/packages/pm-jev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "manifest.json",
    "README.md",
    "CHANGELOG.md",
    "docs/batch-triage.md",
    "docs/link-proposals.md",
    "docs/threshold-calibration.md",
    "calibration/type-dataset-v1.json",
    "calibration/type-report-v1.json",
    "calibration/public-report-v1.json",
    "calibration/exemplar-report-v1.json",
    "calibration/dedupe-report-v1.json",
    "calibration/dedupe-report-v2.json",
    "calibration/duplicate-quality-report-v3.json",
    "docs/duplicate-quality.md",
    "docs/cost-sensitive-abstention.md",
    "examples/cost-policy.json",
    "calibration/cost-policy-report-v1.json",
    "docs/counterfactual-explanations.md",
    "examples/explanation-questions.json",
    "calibration/counterfactual-report-v1.json",
    "docs/policy-replay.md",
    "docs/policy-replay-evidence.json",
    "examples/policy-replay.json",
    "docs/partial-receipt-evidence.json",
    "docs/calibration-drift.md",
    "docs/calibration-drift-evidence.json",
    "examples/calibration-drift.json",
    "docs/exact-cutoffs.md",
    "docs/threshold-domain.md",
    "docs/joint-decisions.md",
    "docs/joint-decisions-evidence.json",
    "examples/joint-decisions.json",
    "docs/label-queue.md",
    "docs/label-queue-evidence.json",
    "examples/label-queue.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test test/*.test.ts",
    "test:live": "node --test --test-reporter=spec test/live.acceptance.ts",
    "test:install": "npm run build && node --test --test-reporter=spec test/install.acceptance.ts",
    "prepack": "npm run verify:public-provenance && npm run build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "docstring": "node scripts/docstring-gate.ts",
    "lint": "node scripts/lint.ts",
    "duplication": "node scripts/duplication-gate.ts",
    "audit:prod": "node --input-type=module -e \"import { spawnSync } from 'node:child_process'; import { devNull } from 'node:os'; const env = { ...process.env, npm_config_userconfig: devNull, NPM_CONFIG_USERCONFIG: devNull }; for (const key of Object.keys(env)) if (key.toLowerCase() === 'npm_config_allow_scripts') delete env[key]; const win = process.platform === 'win32'; const r = spawnSync(win ? 'npm.cmd' : 'npm', ['audit', '--omit=dev', '--ignore-scripts'], { stdio: 'inherit', env, shell: win }); process.exit(r.status ?? 1);\"",
    "pack:dry-run": "npm pack --dry-run",
    "changelog": "pm-changelog --pm-root .agents/pm --mode prepend --output CHANGELOG.md --release-version-from-package --date-from-version --since-previous-tag --until-release-tag --item-url-base https://github.com/unbraind/pm-jev/blob/main/.agents/pm --respect-item-release --status closed,in_progress --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "changelog:full": "pm-changelog --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-jev/blob/main/.agents/pm --respect-item-release --status closed,in_progress --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "changelog:check": "pm-changelog --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-jev/blob/main/.agents/pm --respect-item-release --status closed,in_progress --check --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "release:check": "npm run verify:public-provenance && npm run typecheck && npm run lint && npm run duplication && npm run build && npm run docstring && npm run coverage && npm run audit:prod && npm run pack:dry-run && npm run changelog:check && npm run verify:release-publish-attestation",
    "prepublishOnly": "npm run release:check",
    "release:notes": "pm-changelog --pm-root .agents/pm --stdout --since-previous-tag --until-release-tag --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-jev/blob/main/.agents/pm --respect-item-release --status closed,in_progress --pm-bin ./node_modules/.bin/pm --github-step-summary --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "prepare": "node scripts/prepare-merge-driver.ts",
    "merge:install": "pm merge install",
    "coverage": "npm run build && npm run build:test && c8 --all --include=*.ts --include=scripts/**/*.ts --exclude=test/** --100 --reporter=text --reporter=json-summary --reporter=json node scripts/coverage-gate.ts",
    "verify:release-publish-attestation": "node scripts/verify-release-publish-attestation.ts",
    "calibration:generate": "node scripts/calibrate.ts generate",
    "calibration": "node scripts/calibrate.ts run",
    "calibration:types": "node scripts/calibrate.ts types",
    "verify:public-provenance": "node scripts/verify-public-provenance.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.7.0"
  },
  "peerDependencies": {
    "@unbrained/pm-cli": ">=2026.10.25"
  },
  "devDependencies": {
    "@babel/eslint-parser": "8.0.7",
    "@babel/parser": "^8.0.7",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@babel/types": "^8.0.6",
    "@toon-format/toon": "4.4.0",
    "@types/node": "26.6.5",
    "@unbrained/pm-cli": "2026.10.27",
    "c8": "^12.0.0",
    "eslint": "10.13.0",
    "jscpd": "5.4.2",
    "pm-changelog": "2026.10.27",
    "pm-ops": "2026.10.27",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "keywords": [
    "extension",
    "pm-cli",
    "pm-extension",
    "jev",
    "typesafe-ai",
    "system-one",
    "decisions",
    "ollama",
    "triage",
    "local-first"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "author": {
    "name": "unbrained",
    "url": "https://unbrained.dev/about"
  },
  "pm": {
    "aliases": [
      "jev"
    ],
    "extensions": [
      "."
    ],
    "catalog": {
      "display_name": "pm-jev",
      "category": "decisions",
      "summary": "Typed, local-first System One decisions for pm items (Jev-style models via @typesafe-ai/sdk)",
      "tags": [
        "decisions",
        "typesafe-ai",
        "jev",
        "ollama",
        "triage",
        "dedupe"
      ],
      "links": {
        "docs": "https://github.com/unbraind/pm-jev#readme",
        "npm": "https://www.npmjs.com/package/pm-jev",
        "repository": "https://github.com/unbraind/pm-jev",
        "report": "https://github.com/unbraind/pm-jev/issues"
      }
    },
    "docs": [
      "README.md",
      "CHANGELOG.md"
    ],
    "examples": [
      "README.md"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "coverageGate": {
    "sources": [
      ".",
      "scripts"
    ],
    "tests": [
      "test/*.test.ts"
    ],
    "thresholds": {
      "lines": 100,
      "branches": 100,
      "functions": 100
    },
    "ignore": []
  },
  "duplicationGate": {
    "threshold": 0,
    "minTokens": 50
  }
}
